# ---- API ----
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=jobseeker_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_RANKING_TTL_SECONDS=60
REDIS_CRITERIA_TTL_SECONDS=300

# CORS — comma separated browser origins allowed to call the API
WEB_ORIGIN=http://localhost:5173,http://localhost:8080

# ---- Web ----
# Path the browser calls. Dev proxy (vite) and nginx both strip /api.
VITE_API_BASE_URL=/api
